[Unit]
Description=Bublik periodic GitHub summaries
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=YOUR_LINUX_USER
WorkingDirectory=/home/YOUR_LINUX_USER/ai-advent-llm-api/day-18-scheduled-mcp

Environment=BUBLIK_DB_PATH=/home/YOUR_LINUX_USER/ai-advent-llm-api/day-18-scheduled-mcp/schedule.db
Environment=PYTHONUNBUFFERED=1

ExecStart=/home/YOUR_LINUX_USER/ai-advent-llm-api/.venv/bin/python worker.py

Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target